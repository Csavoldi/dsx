[Unit]
Description=DSX Nanbeige4.3-33B EXL3 4.0 bpw decoder on RTX 5090
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/lxe/dsx-nanbeige
Environment=DSX_NB_BATCH=4096
Environment=DSX_NB_ATTN8=2
Environment=DSX_NB_PART_SIZE=16384
Environment=DSX_NB_EXL3_NARROW=1
Environment=DSX_NB_EXL3_EXPERIMENT=pf4
Environment=DSX_NB_GQA_I8PV=1
Environment=DSX_NB_EXL3=/home/lxe/nanbeige-runner/models/Luni-Nanbeige-4.3-33B-EXL3-4.00bpw
ExecStart=/home/lxe/dsx-nanbeige/target/release/dsx-nanbeige-server --model /home/lxe/nanbeige-runner/quant-exl3/result --ctx 262144 --kv-bits 3 --host-embed --head-bits 4 --lookup 3 --host 127.0.0.1 --port 8095
Restart=on-failure
RestartSec=10
TimeoutStopSec=15

[Install]
WantedBy=default.target
